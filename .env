# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# DATABASE_URL (MySQL/MariaDB - para Hostinger compartido)
# Cuando crees la base en el panel de Hostinger, reemplaza por la conexion que te den, formato:
#   mysql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BASE
DATABASE_URL="mysql://root:password@localhost:3306/kirukard"

# ------------------------------------------------------------------
# COMO CONFIGURAR CUANDO EL CLIENTE TE DÉ LAS CLAVES:
# Solo pega los valores entre comillas en estas variables y reinicia
# el servidor (Ctrl+C y luego `npm run dev`). No cambies el resto.
#   - PayPal:      ya esta configurado (LIVE).
#   - Base URL:    pega tu dominio https://...
#   - Google:      (opcional) solo si quieres login con Google.
#   - SMTP:        (opcional) para recibir correos de nuevas ordenes.
# ------------------------------------------------------------------

# Base URL publica de la tienda (OBLIGATORIA para PayPal LIVE).
# Sin esto, PayPal no podra redirigir al cliente despues de pagar.
# Pon tu dominio real cuando lo tengas, ej: https://tienda.midominio.com
NEXT_PUBLIC_BASE_URL="https://pupils-served-reality-antibody.trycloudflare.com"

