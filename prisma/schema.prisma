generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @db.VarChar(500)
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  price       Float
  image       String?  @db.VarChar(500)
  images      String?  @db.Text
  description String?  @db.Text
  category    String?  @db.VarChar(255)
  stock       Int      @default(0)
  sku         String?  @db.VarChar(255)
  supplier    String?  @db.VarChar(255)
  supplierUrl String?  @db.VarChar(500)
  costPrice   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())
  orderId       String      @unique @db.VarChar(255)
  customerEmail String      @db.VarChar(255)
  customerName  String      @db.VarChar(255)
  customerPhone String?     @db.VarChar(255)
  shippingAddr  String      @db.Text
  shippingCity  String      @db.VarChar(255)
  shippingState String      @db.VarChar(255)
  shippingZip   String      @db.VarChar(50)
  paymentMethod String      @db.VarChar(50)
  subtotal      Float
  shipping      Float
  tax           Float
  total         Float
  status        String      @default("pending") @db.VarChar(50)
  paymentId     String?     @db.VarChar(255)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String  @db.VarChar(255)
  price     Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Settings {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(255)
  value String @db.Text
}
